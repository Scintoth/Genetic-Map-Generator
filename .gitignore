# .NET build output (Directory.Build.props routes everything here)
artifacts/
bin/
obj/
*.user
.vs/
.idea/
*.DotSettings.user

# Headless runs
output/

# Unity adapter project
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/*.csproj
unity/*.sln
unity/*.slnx

# Unity writes .meta files into local (file:) packages; the core is plain source and
# referenced by assembly name, so these are regenerated rather than versioned.
src/**/*.meta
